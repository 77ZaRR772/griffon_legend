# Makefile.linux
# For arch, do:
# sudo pacman -S sdl12-compat sdl_image sdl_mixer pkgconf base-devel
# for arch(cachyos):
PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/share/pkgconfig"
# make -f makefile.linux
# if something odd, remove -O2 optimization flag
CC = gcc
CFLAGS = -O2 -Wall -Wextra -std=c99 `pkg-config --cflags sdl SDL_image SDL_mixer`
LDFLAGS = `pkg-config --libs sdl SDL_image SDL_mixer` -lm
OBJS = griffon.o config.o state.o debug.o editor.o
TARGET = griffon

all: $(TARGET)

$(TARGET): $(OBJS)
	mkdir -p build
	$(CC) $(OBJS) $(LDFLAGS) -o build/$@

%.o: %.c
	$(CC) -c $(CFLAGS) $< -o $@

clean:
	rm -f $(OBJS) build/$(TARGET)

.PHONY: all clean
